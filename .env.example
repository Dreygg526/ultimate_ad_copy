# TEMPLATE ONLY — this file IS COMMITTED TO GIT.
#
# Do not put real keys here. Put them in .env.local, which is gitignored.
# .env.local sits right next to this file; VS Code dims it because git ignores
# it, but it is the one that holds live secrets.

# Atria — ad ingest. Made in-app at Settings & members → API Keys.
# Max two active per workspace; the full key is shown once.
ATRIA_API_KEY=atria-sk_...

# AI — server-side only, never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# Service role key bypasses RLS. Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=...

# Shared secret guarding POST /api/sync until admin auth exists.
SYNC_SECRET=...
